# ozw Environment Configuration
# Only includes variables that are actually used in the code
#
# TIP: Run 'ozw status' to see where this file should be located
#      and to view your current configuration.
#
# Available CLI commands:
#   ozw            - Start the server (default)
#   ozw start    - Start the server
#   ozw status   - Show configuration and data locations
#   ozw help     - Show help information
#   ozw version  - Show version information

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
#API server
PORT=3001
#Frontend port
VITE_PORT=5173

# Host/IP to bind servers to (default: 0.0.0.0 for all interfaces)
# Use 127.0.0.1 to restrict to localhost only
HOST=0.0.0.0

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Required for browser login. Must contain exactly 32 characters.
# Generate one with: openssl rand -hex 16
OZW_ACCESS_TOKEN=

# JWT token lifetime. Defaults to 24h when unset.
JWT_EXPIRES_IN=24h

# Uncomment the following line if you have a custom claude cli path other than the default "claude"
# CLAUDE_CLI_PATH=claude

# Optional POSIX environment file sourced before every Claude Code TUI start/resume.
# This is useful for third-party Anthropic-compatible endpoints and credentials.
# OZW_CLAUDE_ENV_FILE=/absolute/path/to/claude-provider.env

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to the application database file
# Keep SQLite on local storage; NFS/SMB network shares do not support its WAL
# locking protocol safely. Project directories may still live on remote disks.
# This is where the project/session indexes and local application state live.
# Protect this file with operating-system access controls; ozw does not manage
# a separate application-level encryption key for recoverable credentials.
#
# To use a custom location:
# DATABASE_PATH=/path/to/your/local/ozw.db
#
# Claude Code context window size (maximum tokens per session)
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000

# VITE_IS_PLATFORM=false
